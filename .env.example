NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Requeridas solo para CoreStock Plus+ (suscripciones con Stripe).
# Estas 4 son secretas: nunca las pongas con prefijo NEXT_PUBLIC_ ni las subas al repo.
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PLUS=

# Requerida para el análisis de fotos de producto con IA (Google AI
# Studio / Gemini). Secreta: nunca la pongas con prefijo NEXT_PUBLIC_
# ni la subas al repo. Consíguela en https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=
# Opcional: modelo de Gemini a usar (por defecto gemini-flash-latest).
GOOGLE_AI_MODEL=

# Requeridas para el Vendedor de WhatsApp con IA (Empleados IA) — la
# conexión real con WhatsApp Business API de Meta. Secretas: nunca las
# pongas con prefijo NEXT_PUBLIC_ ni las subas al repo.
# WHATSAPP_ACCESS_TOKEN: el token que da Meta en developers.facebook.com
#   (WhatsApp > Primeros pasos). El de esa pantalla es temporal (~24h);
#   para uno permanente, usa un Usuario del sistema en Configuración
#   empresarial de Meta.
# WHATSAPP_VERIFY_TOKEN: un valor que tú inventas — debe ser idéntico
#   acá y en el campo "Verify token" del webhook en el panel de Meta.
# WHATSAPP_APP_SECRET: el "App Secret" de tu app de Meta (Configuración
#   de la app > Básica). Sin esta, el webhook rechaza TODOS los
#   mensajes entrantes (falla cerrado a propósito, igual que
#   STRIPE_WEBHOOK_SECRET) — es obligatoria para que el Vendedor de
#   WhatsApp con IA responda.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Requerida para que el Asistente responda con IA de verdad (OpenRouter).
# Secreta: nunca la pongas con prefijo NEXT_PUBLIC_ ni la subas al repo.
# Consíguela en https://openrouter.ai/keys
#
# Con esta sola llave se encienden TODAS las funciones de IA de la app:
# el Asistente, el análisis de fotos de producto y el vendedor de
# WhatsApp. Si además existe GOOGLE_AI_API_KEY, OpenRouter tiene
# preferencia.
#
# Sin ninguna de las dos, el Asistente NO se rompe: sigue funcionando
# con su motor de reglas (65 temas en 7 idiomas + calculadora), solo que
# sin la conversación abierta. Las otras dos funciones sí avisan que no
# están disponibles. Lo mismo si se acaba el saldo de OpenRouter.
OPENROUTER_API_KEY=
# Opcional: modelo a usar (por defecto anthropic/claude-3.5-haiku).
# La lista y los precios están en https://openrouter.ai/models
OPENROUTER_MODEL=
# Opcional: modelo para ANALIZAR FOTOS de producto (por defecto
# anthropic/claude-3.5-haiku). Va aparte porque tiene que ser un modelo
# que sepa ver imágenes: si cambias OPENROUTER_MODEL por uno más barato
# de solo texto, el análisis de fotos sigue funcionando con este.
OPENROUTER_MODEL_VISION=
# Opcional: la URL pública del sitio. OpenRouter solo la usa para
# atribuir el tráfico en su panel. No es secreta.
NEXT_PUBLIC_SITE_URL=
